				"default": false,
				"refreshes": [
					"content"
				]
			}
		]
	},
	{
		"type": "group",
		"title": "Blocklist",
		"items": [
			{
				"type": "editable-list",
				"key": "blocklist",
				"title": "Add Blocked Tag",
				"lineLimit": 1,
				"inline": true,
				"placeholder": "Tag to block",
				"default": [
					"example"
				],
				"refreshes": [
					"content"
				]
			}
		]
	},
	{
		"type": "group",
		"title": "Saved Artists",
