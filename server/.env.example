# Copy to .env and fill in. Never commit .env.

# Tailscale admin console → Settings → Keys → Generate auth key
TS_AUTHKEY=tskey-auth-xxxxxxxx
# Name of the machine in your tailnet; the address becomes https://<name>.<tailnet>.ts.net
TS_HOSTNAME=reader

# Login for Suwayomi (enter the same in Midoku → Settings → Server)
SUWAYOMI_USER=
SUWAYOMI_PASSWORD=

# Extension repository, e.g. ["https://example.com/index.min.json"]
EXTENSION_STORES=[]

# Set to false to turn off Suwayomi's own web interface once everything is set up
WEB_UI_ENABLED=true

TZ=Etc/UTC

# Optional SOCKS proxy for source traffic (e.g. a VPN provider's SOCKS5 endpoint)
SOCKS_PROXY_ENABLED=false
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=
SOCKS_PROXY_USERNAME=
SOCKS_PROXY_PASSWORD=
